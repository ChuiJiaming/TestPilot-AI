# Sureshot — canonical environment reference.
#
# Copy to a protected path (chmod 600) and fill in real values. Never commit the
# filled-in file. The API fails closed when required values are missing: it
# starts with no auth surface rather than an insecure default.
#
# Required (API + worker) ------------------------------------------------------
TESTPILOT_DATABASE_URL=postgresql://sureshot:CHANGE_ME@127.0.0.1:5432/sureshot
TESTPILOT_REDIS_URL=redis://127.0.0.1:6379/0
TESTPILOT_CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Session signing. Must be >= 32 bytes. Rotating it invalidates access tokens
# but not refresh sessions.
TESTPILOT_AUTH_JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_OR_MORE

# Front-end origins allowed to use the refresh cookie (HTTPS, no path).
TESTPILOT_AUTH_ALLOWED_ORIGINS=https://sureshot.example.com

# Email verification / password reset -----------------------------------------
TESTPILOT_EMAIL_TOKEN_TTL_SECONDS=86400
TESTPILOT_EMAIL_RATE_LIMIT_MAX_REQUESTS=5
TESTPILOT_EMAIL_RATE_LIMIT_WINDOW_SECONDS=900
TESTPILOT_EMAIL_VERIFY_URL=https://sureshot.example.com/verify
# Optional. Without it, password reset requests are accepted but no mail is sent.
TESTPILOT_PASSWORD_RESET_URL=https://sureshot.example.com/reset
TESTPILOT_PASSWORD_RESET_TTL_SECONDS=3600
TESTPILOT_SMTP_HOST=smtp.example.com
TESTPILOT_SMTP_PORT=587
TESTPILOT_SMTP_USERNAME=
TESTPILOT_SMTP_PASSWORD=
TESTPILOT_SMTP_SENDER=Sureshot <no-reply@example.com>
TESTPILOT_SMTP_STARTTLS=true
# Fernet key(s), comma separated. The first key encrypts; all keys decrypt.
TESTPILOT_EMAIL_OUTBOX_ENCRYPTION_KEYS=CHANGE_ME_FERNET_KEY

# Object storage for screenshots, traces, reports ------------------------------
TESTPILOT_S3_BUCKET=sureshot-evidence
TESTPILOT_S3_ENDPOINT_URL=
TESTPILOT_S3_REGION=us-east-1
TESTPILOT_S3_ACCESS_KEY_ID=
TESTPILOT_S3_SECRET_ACCESS_KEY=

# LLM provider (OpenAI-compatible) --------------------------------------------
TESTPILOT_LLM_API_KEY=
TESTPILOT_LLM_BASE_URL=https://api.openai.com/v1
TESTPILOT_LLM_PRICING_JSON={}
TESTPILOT_PLANNER_MODEL=
TESTPILOT_RUN_AGENT_MODEL=

# SecretRef resolution. Without either variable, CI integrations that need a
# secret return 503 instead of calling a provider with an empty credential.
# Keys are "<provider>:<external_key>", e.g. {"vault:ci/github": "ghp_..."}.
TESTPILOT_SECRETREFS_JSON=
TESTPILOT_SECRETREFS_FILE=

# Database pool. Defaults are production-safe for a single 2-vCPU host; raise
# pool size only after checking PostgreSQL max_connections.
TESTPILOT_DB_POOL_SIZE=10
TESTPILOT_DB_MAX_OVERFLOW=20
TESTPILOT_DB_POOL_TIMEOUT_SECONDS=10
TESTPILOT_DB_POOL_RECYCLE_SECONDS=1800
TESTPILOT_DB_STATEMENT_TIMEOUT_MS=15000
TESTPILOT_DB_CONNECT_TIMEOUT_SECONDS=5

# Observability ----------------------------------------------------------------
TESTPILOT_LOG_LEVEL=INFO
TESTPILOT_LOG_FORMAT=json
# Set when /metrics is reachable from outside the loopback interface.
TESTPILOT_METRICS_TOKEN=

# Browser execution ------------------------------------------------------------
TESTPILOT_BROWSER_GATEWAY_URL=https://127.0.0.1:9443
TESTPILOT_BROWSER_GATEWAY_TIMEOUT_SECONDS=120
TESTPILOT_BROWSER_GATEWAY_CA_CERT=/etc/sureshot/tls/gateway-server-ca.crt
TESTPILOT_BROWSER_GATEWAY_CLIENT_CERT=/etc/sureshot/tls/api-client.crt
TESTPILOT_BROWSER_GATEWAY_CLIENT_KEY=/etc/sureshot/tls/api-client.key
TESTPILOT_BROWSER_JOB_TOKEN_SECRET=CHANGE_ME_SHARED_WITH_WORKER

# Backups (deploy/scripts/backup-postgres.sh) ----------------------------------
TESTPILOT_BACKUP_DIR=/var/backups/sureshot
TESTPILOT_BACKUP_RETAIN_DAYS=14
TESTPILOT_BACKUP_S3_URI=
